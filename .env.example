# OPENAI_API_KEY: Primary OpenAI API key for "মাহফুজুর রহমান AI"
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# OPENAI_MODEL: Default primary model (enforced as gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# MULTI-PROVIDER AI FALLBACK SEQUENCE (বহুস্তরীয় স্বয়ংক্রিয় ফলব্যাক চেইন):
# ১. সেকেন্ডারি OpenAI কী (যদি প্রাইমারি কী-এর কোটা শেষ হয়)
OPENAI_API_KEY_SECONDARY=""

# ২. Google Gemini API কী (OpenAI ব্যর্থ হলে প্রথম ব্যাকআপ: gemini-3.8-flash)
# AI Studio এটি স্বয়ংক্রিয়ভাবে পরিবেশ ভেরিয়েবলে ইনজেক্ট করে
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ৩. OpenRouter API কী (OpenAI এবং Gemini উভয়ই ব্যর্থ হলে তৃতীয় ব্যাকআপ)
# Secrets থেকে OPENROUTER_API_KEY কনফিগার করুন
OPENROUTER_API_KEY=""
# OpenRouter মডেল (যেমন: deepseek/deepseek-chat বা meta-llama/llama-3-70b-instruct)
OPENROUTER_MODEL="deepseek/deepseek-chat"

# ৪. স্বয়ংক্রিয় অফলাইন ডিভাইস রিকভারি নলেজ ইঞ্জিন (Autonomous Local Zero-Crash Fallback)

# ৫. টেলিগ্রাম বট ইন্টিগ্রেশন (@mahfuzur_rahman_ai_bot)
TELEGRAM_BOT_TOKEN="8843464101:AAFR2n7aqB0yjZv6RCbUMiXVwsHPjE2wJkU"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

